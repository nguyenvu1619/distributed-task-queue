{
	"info": {
		"_postman_id": "distributed-task-queue-api",
		"name": "Distributed Task Queue API",
		"description": "Postman collection for Distributed Task Queue API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "distributed-task-queue"
	},
	"item": [
		{
			"name": "Queues",
			"item": [
				{
					"name": "Create Queue",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"default-queue\",\n  \"max_attempts\": 3,\n  \"lease_duration\": \"30s\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/queues",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"queues"
							]
						},
						"description": "Create a new queue with specified configuration"
					},
					"response": []
				},
				{
					"name": "Get Queue by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/queues/:id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"queues",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "1",
									"description": "Queue ID"
								}
							]
						},
						"description": "Retrieve a queue by its ID"
					},
					"response": []
				}
			],
			"description": "Queue management endpoints"
		},
		{
			"name": "Jobs",
			"item": [
				{
					"name": "Publish Job",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"idempotency_key\": \"unique-key-123\",\n  \"payload\": \"{\\\"task\\\": \\\"process payment\\\", \\\"amount\\\": 100}\",\n  \"status\": \"PENDING\",\n  \"group_id\": \"group-123\",\n  \"queue_id\": 1\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/jobs",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"jobs"
							]
						},
						"description": "Create and publish a new job to the queue. Note: id, created_at, updated_at, completed_at are auto-generated by the server."
					},
					"response": []
				},
				{
					"name": "Pull Jobs",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/jobs",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"jobs"
							]
						},
						"description": "Retrieve pending jobs from the queue"
					},
					"response": []
				}
			],
			"description": "Job management endpoints"
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:9090",
			"type": "string"
		}
	]
}
